<?xml version="1.0"?>
<ruleset name="SEPS">
	<description>WordPress Coding Standards for the SEPS theme and plugin.</description>

	<file>wp-content/themes/seps</file>
	<file>wp-content/plugins/seps-core</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="seps"/>
				<element value="seps-core"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="seps"/>
				<element value="SEPS"/>
			</property>
		</properties>
	</rule>

	<!-- Theme template tags (inc/template-tags.php) return fully escaped markup. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="seps_button"/>
				<element value="seps_copyright"/>
				<element value="seps_decor"/>
				<element value="seps_icon"/>
				<element value="seps_image"/>
				<element value="seps_menu"/>
				<element value="seps_menu_label"/>
				<element value="seps_multiline"/>
				<element value="seps_social_links"/>
			</property>
		</properties>
	</rule>
</ruleset>
