{
	"name": "seps-theme",
	"version": "1.0.0",
	"private": true,
	"description": "Front-end build for the SEPS WordPress theme.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"browserslist": [
		"> 0.5%",
		"last 2 versions",
		"not dead",
		"not op_mini all"
	],
	"scripts": {
		"build": "npm run build:css && npm run build:js",
		"build:css": "sass assets/src/scss/main.scss assets/dist/css/main.css --style=compressed --no-source-map && postcss assets/dist/css/main.css --use autoprefixer --no-map -r",
		"build:js": "esbuild assets/src/js/main.js --bundle --minify --format=iife --target=es2020 --outfile=assets/dist/js/main.js",
		"dev": "npm-run-all --parallel dev:*",
		"dev:css": "sass assets/src/scss/main.scss assets/dist/css/main.css --embed-source-map --watch",
		"dev:js": "esbuild assets/src/js/main.js --bundle --sourcemap=inline --format=iife --target=es2020 --outfile=assets/dist/js/main.js --watch=forever",
		"lint": "npm run lint:css && npm run lint:js",
		"lint:css": "stylelint \"assets/src/scss/**/*.scss\"",
		"lint:js": "eslint assets/src/js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"autoprefixer": "^10.4.21",
		"esbuild": "^0.25.12",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"sass": "^1.93.3",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0"
	}
}
